---
interface Props {
  pageKey: string;
  placementId: string;
  slotId?: string;
  minHeight?: number;
  label?: string;
  class?: string;
}

const {
  pageKey,
  placementId,
  slotId = '',
  minHeight = 90,
  label = 'Advertisement',
  class: className = '',
} = Astro.props;

// Keep manual ad slots disabled while the site is undergoing AdSense site review so
// crawlers do not see empty ad containers or isolated "Sponsored" text strings.
// Once AdSense marks moaiy.com as "Ready", set ENABLE_MANUAL_SLOTS to true.
const ENABLE_MANUAL_SLOTS = false;
const normalizedSlotId = slotId.trim();
const isConfigured = ENABLE_MANUAL_SLOTS && /^\d{5,}$/.test(normalizedSlotId);
const elementId = `ads-${pageKey}-${placementId}`;
---

{
  isConfigured ? (
    <aside
      class={`ad-slot ${className}`.trim()}
      data-page-key={pageKey}
      data-placement-id={placementId}
      aria-label={label}
      hidden
    >
      <div class="ad-slot-frame">
        <ins
          id={elementId}
          class="adsbygoogle"
          style={`display:block; min-height:${minHeight}px;`}
          data-ad-client="ca-pub-1101411190728746"
          data-ad-slot={normalizedSlotId}
          data-ad-format="auto"
          data-full-width-responsive="true"
        ></ins>
      </div>
    </aside>
  ) : null
}
