---
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import { adPlacementMap } from '../config/ad-placements';
import type { SeoSchema } from '../seo/page-config';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  ogImage?: string;
  robots?: string;
  schema?: SeoSchema[];
  currentPage?: string;
  enableAds?: boolean;
}

const {
  title,
  description,
  canonicalPath,
  ogImage = '/og-image.svg',
  robots = 'index, follow',
  schema = [],
  currentPage = '',
  enableAds,
} = Astro.props;

const shouldLoadAds =
  typeof enableAds === 'boolean'
    ? enableAds
    : Boolean(currentPage && Object.prototype.hasOwnProperty.call(adPlacementMap, currentPage));

const siteUrl = Astro.site ?? new URL('https://moaiy.com');
const normalizedPath =
  canonicalPath === '/' ? '/' : canonicalPath.endsWith('/') ? canonicalPath : `${canonicalPath}/`;
const canonicalUrl = new URL(normalizedPath, siteUrl).toString();
const ogImageUrl = new URL(ogImage, siteUrl).toString();

const X_URL = 'https://x.com/moaiycom';
const GITHUB_URL = 'https://github.com/moaiy-com/moaiy';
const ETH_DONATION_ADDRESS = '0x7945C89E6Dfc83A10894f1d5149c1650fBa4Aa9c';
const RELEASES_URL = 'https://github.com/moaiy-com/moaiy/releases';

const footerLinks = [
  { href: '/download/', label: 'Download' },
  { href: '/docs/', label: 'Docs' },
  { href: '/security/', label: 'Security' },
  { href: '/features/', label: 'Features' },
  { href: '/about/', label: 'About' },
];

const policyLinks = [
  { href: '/privacy/', label: 'Privacy Policy' },
  { href: '/terms/', label: 'Terms' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" />

    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Moaiy" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content="Moaiy open-source encryption project" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@moaiycom" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {schema.map((entry) => (
      <script type="application/ld+json" set:html={JSON.stringify(entry)} />
    ))}

    {shouldLoadAds && (
      <script
        async
        src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1101411190728746"
        crossorigin="anonymous"
      ></script>
    )}
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-1EFMK5162Q"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        window.dataLayer.push(arguments);
      }
      window.gtag = window.gtag || gtag;
      window.gtag('js', new Date());
      window.gtag('config', 'G-1EFMK5162Q');

      document.addEventListener('click', (event) => {
        const target = event.target instanceof Element ? event.target.closest('a[data-analytics-event]') : null;
        if (!target || !(target instanceof HTMLAnchorElement)) {
          return;
        }

        const eventName = target.dataset.analyticsEvent;
        if (!eventName) {
          return;
        }

        window.gtag('event', eventName, {
          link_url: target.href,
          link_text: (target.textContent || '').trim(),
          page_path: window.location.pathname,
        });
      });
    </script>
  </head>
  <body class="bg-bg-primary text-text-primary font-body antialiased">
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-md focus:bg-bg-tertiary focus:px-4 focus:py-2 focus:text-sm focus:text-text-primary focus:shadow-lg"
    >
      Skip to content
    </a>
    <Navigation currentPage={currentPage} />
    <div id="content" class="pt-20">
      <slot />
    </div>
    <footer class="border-t border-line-strong/70 bg-bg-primary/90">
      <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-8 md:grid-cols-[1.3fr_1fr_1fr]">
          <div>
            <h2 class="mb-3 font-heading text-lg font-semibold text-text-primary">Moaiy</h2>
            <p class="max-w-md text-sm text-text-secondary">
              Drag-and-drop OpenPGP file encryption for macOS. Free, local-first, and open source.
            </p>
            <p class="mt-3 break-all font-code text-xs text-text-tertiary">
              Donation (ETH): <span class="text-text-secondary">{ETH_DONATION_ADDRESS}</span>
            </p>
          </div>
          <div>
            <h2 class="mb-3 font-heading text-lg font-semibold text-text-primary">Core</h2>
            <div class="flex flex-col gap-2">
              {footerLinks.map((link) => (
                <a
                  href={link.href}
                  class="w-fit text-sm text-text-secondary transition-colors hover:text-accent-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-primary/70 focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary"
                >
                  {link.label}
                </a>
              ))}
            </div>
          </div>
          <div>
            <h2 class="mb-3 font-heading text-lg font-semibold text-text-primary">Project & Legal</h2>
            <div class="flex flex-col gap-2">
              <a
                href={RELEASES_URL}
                target="_blank"
                rel="noopener noreferrer"
                data-analytics-event="download_click"
                class="w-fit text-sm text-text-secondary transition-colors hover:text-accent-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-primary/70 focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary"
              >
                Releases
              </a>
              <a
                href={GITHUB_URL}
                target="_blank"
                rel="noopener noreferrer"
                data-analytics-event="github_click"
                class="w-fit text-sm text-text-secondary transition-colors hover:text-accent-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-primary/70 focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary"
              >
                GitHub
              </a>
              <a
                href={X_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="w-fit text-sm text-text-secondary transition-colors hover:text-accent-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-primary/70 focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary"
              >
                X (@moaiycom)
              </a>
              {policyLinks.map((link) => (
                <a
                  href={link.href}
                  class="w-fit text-sm text-text-secondary transition-colors hover:text-accent-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-primary/70 focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary"
                >
                  {link.label}
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
