---
import LinkCard from '../components/ui/LinkCard.astro';
import PageHero from '../components/ui/PageHero.astro';
import Panel from '../components/ui/Panel.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageSeo } from '../seo/page-config';

const seo = pageSeo.gpgToolsAlternative;
---

<BaseLayout {...seo}>
  <main class="page-shell">
    <div class="page-container-narrow">
      <PageHero
        title="Is Moaiy a simpler GPG alternative on macOS?"
        subtitle="Compare everyday drag-and-drop usability, key management clarity, and system footprint."
      />

      <Panel tone="strong">
        <h2 class="font-heading text-2xl font-semibold text-text-primary md:text-3xl">Workflow comparison</h2>
        <div class="mt-6 overflow-x-auto">
          <table class="w-full min-w-[620px] text-left text-sm text-text-secondary">
            <thead>
              <tr class="border-b border-line-subtle text-text-primary">
                <th class="py-3 pr-4 font-heading">Dimension</th>
                <th class="px-4 py-3 font-heading">Traditional GPG suites & CLI</th>
                <th class="px-4 py-3 font-heading">Moaiy on macOS</th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-b border-line-strong">
                <td class="py-3 pr-4">Daily file encryption</td>
                <td class="px-4 py-3">Terminal flags or multi-app toolchains</td>
                <td class="px-4 py-3">Focused drag-and-drop macOS window</td>
              </tr>
              <tr class="border-b border-line-strong">
                <td class="py-3 pr-4">Key management</td>
                <td class="px-4 py-3">Complex subkey flags and technical jargon</td>
                <td class="px-4 py-3">Visual keyring for creating, importing, and exporting keys</td>
              </tr>
              <tr class="border-b border-line-strong">
                <td class="py-3 pr-4">System footprint</td>
                <td class="px-4 py-3">System-wide Mail plugins and background services</td>
                <td class="px-4 py-3">Standalone local app that runs only when you open it</td>
              </tr>
              <tr>
                <td class="py-3 pr-4">License & pricing</td>
                <td class="px-4 py-3">Mixed licensing or paid support subscriptions</td>
                <td class="px-4 py-3">100% free and open source (MIT License)</td>
              </tr>
            </tbody>
          </table>
        </div>
      </Panel>

      <Panel class="mt-12">
        <h2 class="font-heading text-2xl font-semibold text-text-primary md:text-3xl">When Moaiy fits well</h2>
        <ul class="list-compact">
          <li>You want to encrypt and decrypt files on macOS with drag and drop rather than terminal commands.</li>
          <li>You need both recipient public-key mode and simple password mode in one clean window.</li>
          <li>You prefer a lightweight, 100% open-source Mac app with verifiable GitHub releases.</li>
        </ul>
      </Panel>

      <section class="link-grid">
        <LinkCard href="/docs/" title="Read Docs" description="Visual step-by-step macOS guides." />
        <LinkCard href="/download/" analyticsEvent="download_click" title="Get Moaiy" description="Download the official macOS release." />
        <LinkCard href="/openpgp-made-simple/" title="OpenPGP Primer" description="Plain-language guide to keys and passphrases." />
      </section>
    </div>
  </main>
</BaseLayout>
