---
import PageHero from '../components/ui/PageHero.astro';
import Panel from '../components/ui/Panel.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageSeo } from '../seo/page-config';

const seo = pageSeo.privacy;
---

<BaseLayout {...seo}>
  <main class="page-shell">
    <div class="page-container-compact">
      <Panel tone="strong">
        <PageHero centered={false} class="mb-0" title="Privacy Policy" />
        <p class="mt-3 text-sm text-text-tertiary">Effective date: April 2026</p>

        <div class="mt-8 space-y-6 text-sm leading-relaxed text-text-secondary">
          <section>
            <h2 class="font-heading text-2xl font-semibold text-text-primary">1. Scope and local-first software guarantee</h2>
            <p class="mt-2">
              This Privacy Policy applies to the official Moaiy website (<a href="https://moaiy.com" class="text-accent-primary hover:underline">https://moaiy.com</a>)
              and our official support and security email channels.
            </p>
            <p class="mt-2">
              <strong>The Moaiy macOS application itself operates 100% locally on your computer.</strong> The desktop application does not upload your plaintext files, encrypted archives, private keys, or passphrases to any remote server operated by Moaiy or third parties.
            </p>
          </section>

          <section>
            <h2 class="font-heading text-2xl font-semibold text-text-primary">2. Website analytics</h2>
            <p class="mt-2">
              On <a href="https://moaiy.com" class="text-accent-primary hover:underline">moaiy.com</a>, we use Google Analytics (GA4) to understand aggregate traffic patterns, such as which documentation guides are visited most frequently, browser and operating system categories, and outbound clicks to our official GitHub repository. Analytics data is used strictly to improve documentation clarity and site performance.
            </p>
          </section>

          <section>
            <h2 class="font-heading text-2xl font-semibold text-text-primary">3. Google AdSense, cookies, and third-party advertising</h2>
            <p class="mt-2">
              We may display sponsored advertisements on selected documentation and guide pages through <strong>Google AdSense</strong> to help fund open-source development and hosting costs.
            </p>
            <ul class="list-compact mt-3">
              <li>Third-party vendors, including Google, use cookies to serve ads based on a user’s prior visits to this website or other websites on the internet.</li>
              <li>Google’s use of advertising cookies enables it and its partners to serve ads to users based on their visit to our site and/or other sites on the internet.</li>
              <li>Users may opt out of personalized advertising by visiting <a href="https://adssettings.google.com" target="_blank" rel="noopener noreferrer" class="text-accent-primary hover:underline">Google Ads Settings</a>. Alternatively, you can opt out of a third-party vendor’s use of cookies for personalized advertising by visiting <a href="https://www.aboutads.info/choices/" target="_blank" rel="noopener noreferrer" class="text-accent-primary hover:underline">www.aboutads.info/choices</a>.</li>
            </ul>
          </section>

          <section>
            <h2 class="font-heading text-2xl font-semibold text-text-primary">4. Regional consent (EEA, UK, Switzerland, and California)</h2>
            <p class="mt-2">
              Depending on your jurisdiction, you have rights regarding access to, deletion of, and restriction of personal data processing. For visitors from the European Economic Area (EEA), the United Kingdom, and Switzerland, we use Google-certified consent management messaging to request and honor your consent preferences before storing or accessing cookies for personalized advertising.
            </p>
          </section>

          <section>
            <h2 class="font-heading text-2xl font-semibold text-text-primary">5. Support and security correspondence</h2>
            <p class="mt-2">
              When you email <a href="mailto:support@moaiy.com" class="text-accent-primary hover:underline">support@moaiy.com</a> or <a href="mailto:security@moaiy.com" class="text-accent-primary hover:underline">security@moaiy.com</a>, we process the contact address and diagnostic details you voluntarily provide solely to investigate and resolve your inquiry. Never send private keys, recovery seed phrases, or passphrases via email.
            </p>
          </section>

          <section>
            <h2 class="font-heading text-2xl font-semibold text-text-primary">6. Data retention and third-party links</h2>
            <p class="mt-2">
              Support and security email records are retained only for as long as necessary to resolve issues, maintain security audit trails, or comply with applicable law. Links from this website to external platforms—such as GitHub (<a href="https://github.com/moaiy-com/moaiy" target="_blank" rel="noopener noreferrer" class="text-accent-primary hover:underline">github.com/moaiy-com/moaiy</a>) or X—are governed by those platforms’ respective privacy policies.
            </p>
          </section>

          <section>
            <h2 class="font-heading text-2xl font-semibold text-text-primary">7. Contact</h2>
            <p class="mt-2">
              For privacy questions or data requests, contact:
              <a href="mailto:support@moaiy.com" class="text-accent-primary hover:underline">support@moaiy.com</a>
            </p>
          </section>
        </div>
      </Panel>
    </div>
  </main>
</BaseLayout>
