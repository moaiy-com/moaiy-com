---
import PageHero from '../components/ui/PageHero.astro';
import Panel from '../components/ui/Panel.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageSeo } from '../seo/page-config';

const seo = pageSeo.terms;
---

<BaseLayout {...seo}>
  <main class="page-shell">
    <div class="page-container-compact">
      <Panel tone="strong">
        <PageHero centered={false} class="mb-0" title="Terms of Use" />
        <p class="mt-3 text-sm text-text-tertiary">Effective date: April 2026</p>

        <div class="mt-8 space-y-6 text-sm leading-relaxed text-text-secondary">
          <section>
            <h2 class="font-heading text-2xl font-semibold text-text-primary">1. Acceptance and use of website</h2>
            <p class="mt-2">
              By accessing <a href="https://moaiy.com" class="text-accent-primary hover:underline">https://moaiy.com</a>, you agree to use the website and its documentation lawfully. You must not attempt to disrupt site availability, scrape protected endpoints abusively, or misrepresent unofficial builds as official Moaiy releases.
            </p>
          </section>

          <section>
            <h2 class="font-heading text-2xl font-semibold text-text-primary">2. Open-source software license</h2>
            <p class="mt-2">
              The Moaiy macOS application source code is licensed under the permissive <a href="https://github.com/moaiy-com/moaiy/blob/main/LICENSE" target="_blank" rel="noopener noreferrer" class="text-accent-primary hover:underline">MIT License</a>. You are free to inspect, use, modify, and redistribute the software in accordance with the terms of the MIT License included in the official GitHub repository.
            </p>
          </section>

          <section>
            <h2 class="font-heading text-2xl font-semibold text-text-primary">3. User responsibility for cryptographic keys and backups</h2>
            <p class="mt-2">
              Moaiy performs local OpenPGP encryption on your Mac without any central key-recovery server. If you lose your private key, hardware token PIN, or encryption passphrase, <strong>Moaiy cannot recover or reset your encrypted files</strong>. You are solely responsible for maintaining secure offline backups of your keys, passphrases, and revocation certificates.
            </p>
          </section>

          <section>
            <h2 class="font-heading text-2xl font-semibold text-text-primary">4. Disclaimer of warranties and limitation of liability</h2>
            <p class="mt-2">
              THE SOFTWARE AND WEBSITE CONTENT ARE PROVIDED “AS IS”, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE, AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES, DATA LOSS, OR OTHER LIABILITY ARISING FROM THE USE OF THE SOFTWARE OR DOCUMENTATION.
            </p>
          </section>

          <section>
            <h2 class="font-heading text-2xl font-semibold text-text-primary">5. Third-party services and external links</h2>
            <p class="mt-2">
              Official release binaries and source code are hosted on GitHub (<a href="https://github.com/moaiy-com/moaiy/releases" target="_blank" rel="noopener noreferrer" class="text-accent-primary hover:underline">github.com/moaiy-com/moaiy/releases</a>). Your use of third-party services is subject to their respective terms of service and privacy policies.
            </p>
          </section>

          <section>
            <h2 class="font-heading text-2xl font-semibold text-text-primary">6. Contact</h2>
            <p class="mt-2">
              Questions regarding these Terms of Use may be directed to
              <a href="mailto:support@moaiy.com" class="text-accent-primary hover:underline">support@moaiy.com</a>.
            </p>
          </section>
        </div>
      </Panel>
    </div>
  </main>
</BaseLayout>
