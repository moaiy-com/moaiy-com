---
import LinkCard from '../components/ui/LinkCard.astro';
import PageHero from '../components/ui/PageHero.astro';
import Panel from '../components/ui/Panel.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageSeo } from '../seo/page-config';

const seo = pageSeo.openpgpMadeSimple;
---

<BaseLayout {...seo}>
  <main class="page-shell">
    <div class="page-container-compact">
      <PageHero
        centered={false}
        title="OpenPGP made simple with Moaiy"
        subtitle="Understand how OpenPGP keys work in plain language—and use them through a visual macOS interface without touching the terminal."
      />

      <Panel tone="strong">
        <h2 class="font-heading text-2xl font-semibold text-text-primary md:text-3xl">Core concepts in plain language</h2>
        <ul class="list-compact">
          <li><span class="text-text-primary">Public key</span>: like an open padlock you share with anyone who wants to lock files for you.</li>
          <li><span class="text-text-primary">Private key</span>: stays safely on your Mac (or smart card) and unlocks files encrypted for your public key.</li>
          <li><span class="text-text-primary">Passphrase</span>: the password that protects your private key before it can be used.</li>
        </ul>
      </Panel>

      <Panel class="mt-12">
        <h2 class="font-heading text-2xl font-semibold text-text-primary md:text-3xl">How it works visually in Moaiy</h2>
        <ol class="mt-5 list-inside list-decimal space-y-3 text-sm leading-relaxed text-text-secondary">
          <li><strong class="text-text-primary">Create your key pair:</strong> Open Moaiy’s Key Manager, enter your name, email, and a strong passphrase, and click <strong>Create</strong>.</li>
          <li><strong class="text-text-primary">Share your public key:</strong> Click <strong>Export Public Key</strong> in Moaiy and send the <code>.asc</code> or <code>.key</code> file to your collaborators.</li>
          <li><strong class="text-text-primary">Encrypt for a recipient:</strong> Import a colleague’s public key, drag <code>payroll.csv</code> into Moaiy, select their name, and click <strong>Encrypt</strong>.</li>
          <li><strong class="text-text-primary">Decrypt incoming files:</strong> Drag an encrypted <code>.gpg</code> file addressed to you into Moaiy and enter your passphrase to unlock it.</li>
        </ol>
      </Panel>

      <Panel class="mt-12">
        <h2 class="font-heading text-2xl font-semibold text-text-primary md:text-3xl">Common mistakes to avoid</h2>
        <ul class="list-compact">
          <li>Accidentally sharing your private key instead of your public key.</li>
          <li>Storing unencrypted private key backups in shared cloud folders.</li>
          <li>Reusing weak passphrases or forgetting to keep an offline recovery backup.</li>
        </ul>
      </Panel>

      <section class="link-grid">
        <LinkCard href="/docs/" title="Visual Docs" description="Step-by-step macOS guides and FAQs." />
        <LinkCard href="/verification/" title="Verification" description="Trusted download and checksum checklist." />
        <LinkCard href="/gpg-tools-alternative/" title="Compare Workflows" description="Compare Moaiy with traditional GPG tools." />
      </section>
    </div>
  </main>
</BaseLayout>
