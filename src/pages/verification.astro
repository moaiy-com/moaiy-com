---
import LinkCard from '../components/ui/LinkCard.astro';
import PageHero from '../components/ui/PageHero.astro';
import Panel from '../components/ui/Panel.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageSeo } from '../seo/page-config';

const seo = pageSeo.verification;
---

<BaseLayout {...seo}>
  <main class="page-shell">
    <div class="page-container-narrow">
      <PageHero
        title="Verification and checksum guide"
        subtitle="Confirm that your downloaded Moaiy macOS installer is authentic and unmodified before opening it."
      />

      <Panel tone="strong">
        <h2 class="font-heading text-2xl font-semibold text-text-primary md:text-3xl">Verification checklist</h2>
        <ol class="mt-5 list-inside list-decimal space-y-2 text-sm leading-relaxed text-text-secondary">
          <li>Download the macOS installer (such as <code>Moaiy.dmg</code> or <code>Moaiy.pkg</code>) only from official GitHub Releases.</li>
          <li>Download the matching <code>SHA256SUMS</code> or signature file from the same release entry.</li>
          <li>Compute the local SHA-256 hash on your Mac and confirm it matches the published value character for character.</li>
          <li>Verify the cryptographic signature when a release signing file (<code>.sig</code>) is provided.</li>
        </ol>
      </Panel>

      <Panel class="mt-12">
        <h2 class="font-heading text-2xl font-semibold text-text-primary md:text-3xl">How to check your download on macOS</h2>
        <p class="mt-3 text-sm leading-relaxed text-text-secondary">
          You can use macOS’s built-in <code>shasum</code> utility to check the downloaded installer file (replace <code>Moaiy.dmg</code> with the exact filename you downloaded):
        </p>
        <div class="code-block">
          <div class="text-text-tertiary"># 1. Compute SHA-256 hash of the downloaded installer</div>
          <div><span class="text-accent-primary">$</span> shasum -a 256 ~/Downloads/Moaiy.dmg</div>
          <div class="text-text-tertiary"># 2. Optional: verify detached signature if provided on the release</div>
          <div><span class="text-accent-primary">$</span> gpg --verify ~/Downloads/Moaiy.dmg.sig ~/Downloads/Moaiy.dmg</div>
        </div>
      </Panel>

      <Panel class="mt-12">
        <h2 class="font-heading text-2xl font-semibold text-text-primary md:text-3xl">If verification fails</h2>
        <ul class="list-compact">
          <li>Do not open or install the downloaded file.</li>
          <li>Delete the file and download a fresh copy directly from the official GitHub Releases page.</li>
          <li>
            Report any persistent checksum or signature mismatch to
            <a href="mailto:security@moaiy.com" class="text-accent-primary hover:underline">security@moaiy.com</a>.
          </li>
        </ul>
      </Panel>

      <section class="link-grid">
        <LinkCard href="/download/" title="Download" description="Official macOS release channel." />
        <LinkCard href="/security/" title="Security" description="Disclosure flow and assurance status." />
        <LinkCard href="/release-notes/" title="Release Notes" description="Recent milestones and release links." />
      </section>
    </div>
  </main>
</BaseLayout>
