---
import LinkCard from '../components/ui/LinkCard.astro';
import PageHero from '../components/ui/PageHero.astro';
import Panel from '../components/ui/Panel.astro';
import AdSlot from '../components/ads/AdSlot.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { adPlacementMap } from '../config/ad-placements';
import { pageSeo } from '../seo/page-config';

const seo = pageSeo.docs;
const releaseUrl = 'https://github.com/moaiy-com/moaiy/releases';
const [docsMidAd, docsPreFaqAd] = adPlacementMap.docs;
---

<BaseLayout {...seo}>
  <main class="page-shell">
    <div class="page-container">
      <PageHero
        title="Docs: simple visual guides for daily use"
        subtitle="Protect and unlock files on your Mac in four clear steps—no terminal commands required."
      />

      <section class="grid grid-cols-1 gap-5 lg:grid-cols-2">
        <Panel as="article" tone="strong" class="p-6">
          <h2 class="font-heading text-2xl font-semibold text-text-primary">1. Download and install on macOS</h2>
          <p class="mt-3 text-sm leading-relaxed text-text-secondary">
            Download the latest official release from GitHub Releases, verify the installer if desired, and drag <strong>Moaiy.app</strong> into your <strong>Applications</strong> folder.
          </p>
          <a
            href={releaseUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-analytics-event="download_click"
            class="btn-primary mt-5"
          >
            Open Releases
          </a>
        </Panel>

        <Panel as="article" tone="strong" class="p-6">
          <h2 class="font-heading text-2xl font-semibold text-text-primary">2. Create or import keys visually</h2>
          <p class="mt-3 text-sm leading-relaxed text-text-secondary">
            Open Moaiy’s Key Manager and click <strong>New Key</strong> to create your personal OpenPGP key pair with your name, email, and passphrase—or click <strong>Import</strong> to add a collaborator’s public key file.
          </p>
        </Panel>

        <Panel as="article" tone="strong" class="p-6">
          <h2 class="font-heading text-2xl font-semibold text-text-primary">3. Drag and drop to encrypt</h2>
          <p class="mt-3 text-sm leading-relaxed text-text-secondary">
            Drag any file or folder archive into the Moaiy window. Choose <strong>Recipient Mode</strong> to encrypt for selected contacts’ public keys, or <strong>Password Mode</strong> to lock the file with a shared passphrase, then click <strong>Encrypt</strong>.
          </p>
        </Panel>

        <Panel as="article" tone="strong" class="p-6">
          <h2 class="font-heading text-2xl font-semibold text-text-primary">4. Decrypt and verify with confidence</h2>
          <p class="mt-3 text-sm leading-relaxed text-text-secondary">
            Drop an encrypted <code>.gpg</code> or <code>.pgp</code> file into Moaiy, enter your passphrase when prompted, and save the restored file locally on your Mac.
          </p>
          <a href="/verification/" class="mt-4 inline-flex text-sm font-semibold text-accent-primary hover:underline">Read download verification guide</a>
        </Panel>
      </section>

      <AdSlot pageKey="docs" {...docsMidAd} class="mt-12" />

      <Panel class="mt-12">
        <h2 class="font-heading text-2xl font-semibold text-text-primary md:text-3xl">Smart card and hardware token notes</h2>
        <p class="mt-3 text-sm leading-relaxed text-text-secondary">
          If you use an OpenPGP smart card or hardware token (such as a YubiKey), keep your private key material on the hardware token and test your PIN unlock flow in Moaiy before relying on it for urgent work.
        </p>
        <p class="mt-3 text-sm leading-relaxed text-text-secondary">
          Use this guide for practical setup patterns, backup planning, and recovery checks:
          <a href="/smartcard-encryption-guide/" class="ml-1 text-accent-primary hover:underline">Smart card encryption guide</a>.
        </p>
      </Panel>

      <Panel class="mt-12">
        <h2 class="font-heading text-2xl font-semibold text-text-primary md:text-3xl">Build from source in Xcode (optional)</h2>
        <p class="mt-3 text-sm leading-relaxed text-text-secondary">
          Developers who prefer to inspect and compile the native macOS app themselves can build directly from the public Xcode project:
        </p>
        <div class="code-block">
          <div>git clone https://github.com/moaiy-com/moaiy.git</div>
          <div>cd moaiy</div>
          <div>open Moaiy/Moaiy.xcodeproj</div>
        </div>
      </Panel>

      <section class="link-grid">
        <LinkCard href="https://github.com/moaiy-com/moaiy/blob/main/README.md" target="_blank" title="README" description="Project overview and repository guide." />
        <LinkCard href="https://github.com/moaiy-com/moaiy/blob/main/CONTRIBUTING.md" target="_blank" title="CONTRIBUTING" description="How to contribute and submit improvements." />
        <LinkCard href="https://github.com/moaiy-com/moaiy/blob/main/SECURITY.md" target="_blank" title="SECURITY" description="How to report security issues privately." />
      </section>

      <AdSlot pageKey="docs" {...docsPreFaqAd} class="mt-12" />

      <section class="mt-12 space-y-3">
        <details class="rounded-lg border border-line-strong bg-bg-secondary/65">
          <summary class="cursor-pointer px-5 py-3 text-sm font-semibold text-text-primary">What is Moaiy?</summary>
          <p class="px-5 pb-4 text-sm leading-relaxed text-text-secondary">Moaiy is a free, open-source native macOS app that lets you encrypt and decrypt files with simple drag-and-drop steps.</p>
        </details>
        <details class="rounded-lg border border-line-strong bg-bg-secondary/65">
          <summary class="cursor-pointer px-5 py-3 text-sm font-semibold text-text-primary">Do I need to use the Terminal or command line?</summary>
          <p class="px-5 pb-4 text-sm leading-relaxed text-text-secondary">No. Moaiy is designed around a clean graphical interface on macOS—key creation, file encryption, and decryption are all handled visually.</p>
        </details>
        <details class="rounded-lg border border-line-strong bg-bg-secondary/65">
          <summary class="cursor-pointer px-5 py-3 text-sm font-semibold text-text-primary">How do I download safely?</summary>
          <p class="px-5 pb-4 text-sm leading-relaxed text-text-secondary">Download from official GitHub Releases and verify checksums before opening the installer.</p>
        </details>
        <details class="rounded-lg border border-line-strong bg-bg-secondary/65">
          <summary class="cursor-pointer px-5 py-3 text-sm font-semibold text-text-primary">Does Moaiy upload unencrypted files?</summary>
          <p class="px-5 pb-4 text-sm leading-relaxed text-text-secondary">No. Moaiy performs all encryption and decryption locally on your Mac. See the security page for details.</p>
        </details>
      </section>
    </div>
  </main>
</BaseLayout>
