---
import LinkCard from '../components/ui/LinkCard.astro';
import PageHero from '../components/ui/PageHero.astro';
import Panel from '../components/ui/Panel.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageSeo } from '../seo/page-config';

const seo = pageSeo.download;
const releaseUrl = 'https://github.com/moaiy-com/moaiy/releases';
---

<BaseLayout {...seo}>
  <main class="page-shell">
    <div class="page-container">
      <PageHero
        title="Download Moaiy for macOS"
        subtitle="Get the official native macOS application from GitHub Releases and verify your installer before opening."
      />

      <Panel tone="strong">
        <h2 class="font-heading text-2xl font-semibold text-text-primary md:text-3xl">Official macOS release channel</h2>
        <p class="mt-3 max-w-3xl text-sm leading-relaxed text-text-secondary">
          Moaiy is distributed free and open source under the MIT License through GitHub Releases. Download the latest macOS build, compare the published SHA-256 checksum, and drag <strong>Moaiy.app</strong> into your <strong>Applications</strong> folder.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href={releaseUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-analytics-event="download_click"
            class="btn-primary"
          >
            Open GitHub Releases
          </a>
          <a href="/verification/" class="btn-secondary">
            Check Verification Guide
          </a>
        </div>
      </Panel>

      <Panel class="mt-12">
        <h2 class="font-heading text-2xl font-semibold text-text-primary md:text-3xl">System requirements & specifications</h2>
        <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2">
          <div class="rounded-lg border border-line-subtle bg-bg-primary/45 p-4">
            <p class="text-xs font-semibold uppercase tracking-[0.08em] text-accent-primary">Operating System</p>
            <p class="mt-1 text-sm text-text-secondary">macOS 13.0 (Ventura), macOS 14 (Sonoma), macOS 15 (Sequoia), or later.</p>
          </div>
          <div class="rounded-lg border border-line-subtle bg-bg-primary/45 p-4">
            <p class="text-xs font-semibold uppercase tracking-[0.08em] text-accent-primary">Processor Architecture</p>
            <p class="mt-1 text-sm text-text-secondary">Apple Silicon (M1 / M2 / M3 / M4) and Intel 64-bit Mac systems.</p>
          </div>
          <div class="rounded-lg border border-line-subtle bg-bg-primary/45 p-4">
            <p class="text-xs font-semibold uppercase tracking-[0.08em] text-accent-primary">Encryption Standard</p>
            <p class="mt-1 text-sm text-text-secondary">RFC 4880 / OpenPGP compatible (`.gpg`, `.pgp`, and `.asc` key & file formats).</p>
          </div>
          <div class="rounded-lg border border-line-subtle bg-bg-primary/45 p-4">
            <p class="text-xs font-semibold uppercase tracking-[0.08em] text-accent-primary">Network & Privacy</p>
            <p class="mt-1 text-sm text-text-secondary">Works 100% offline after installation; no account registration or cloud connection required.</p>
          </div>
        </div>
      </Panel>

      <Panel class="mt-12">
        <h2 class="font-heading text-2xl font-semibold text-text-primary md:text-3xl">Installation & first-launch checklist</h2>
        <ol class="mt-5 list-inside list-decimal space-y-3 text-sm leading-relaxed text-text-secondary">
          <li>
            <strong class="text-text-primary">Download the release package:</strong> Visit the official <a href={releaseUrl} target="_blank" rel="noopener noreferrer" class="text-accent-primary hover:underline">GitHub Releases page</a> and download the latest macOS asset along with its accompanying checksum file.
          </li>
          <li>
            <strong class="text-text-primary">Verify file integrity:</strong> Run <code>shasum -a 256</code> in Terminal on the downloaded package and confirm the hash matches the release notes (see our <a href="/verification/" class="text-accent-primary hover:underline">Verification Guide</a>).
          </li>
          <li>
            <strong class="text-text-primary">Move to Applications:</strong> Open the disk image or archive and drag <strong>Moaiy.app</strong> into your <code>/Applications</code> directory so macOS App Translocation does not restrict local keyring access.
          </li>
          <li>
            <strong class="text-text-primary">Set up your first key:</strong> Launch Moaiy, open the visual Key Manager to generate a personal OpenPGP key pair or import a contact’s public key, and test encrypting a sample file before deleting any original sensitive documents.
          </li>
        </ol>
      </Panel>

      <Panel class="mt-12">
        <h2 class="font-heading text-2xl font-semibold text-text-primary md:text-3xl">Using Moaiy with smart cards</h2>
        <p class="mt-3 text-sm leading-relaxed text-text-secondary">
          If you store OpenPGP keys on a smart card or hardware security token (such as a YubiKey), test your card reader detection, PIN unlock flow, and offline backup keys before relying on hardware-backed encryption for daily production files.
        </p>
        <a href="/smartcard-encryption-guide/" class="mt-4 inline-flex text-sm font-semibold text-accent-primary hover:underline">
          Open smart card encryption guide
        </a>
      </Panel>

      <Panel class="mt-12">
        <h2 class="font-heading text-2xl font-semibold text-text-primary md:text-3xl">Build from source in Xcode (optional)</h2>
        <p class="mt-3 text-sm leading-relaxed text-text-secondary">
          Developers and security auditors who prefer to compile Moaiy from source can clone the public repository and build the native macOS target directly in Xcode:
        </p>
        <div class="code-block">
          <div>git clone https://github.com/moaiy-com/moaiy.git</div>
          <div>cd moaiy</div>
          <div>open Moaiy/Moaiy.xcodeproj</div>
        </div>
      </Panel>

      <section class="link-grid">
        <LinkCard href="/verification/" title="Verification" description="Step-by-step SHA-256 and signature checklist." />
        <LinkCard href="/docs/" title="Documentation" description="Visual macOS user manual and troubleshooting." />
        <LinkCard href="/release-notes/" title="Release Notes" description="Recent product and documentation milestones." />
      </section>
    </div>
  </main>
</BaseLayout>
