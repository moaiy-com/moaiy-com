---
import LinkCard from '../components/ui/LinkCard.astro';
import PageHero from '../components/ui/PageHero.astro';
import Panel from '../components/ui/Panel.astro';
import AdSlot from '../components/ads/AdSlot.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { adPlacementMap } from '../config/ad-placements';
import { pageSeo } from '../seo/page-config';

const seo = pageSeo.download;
const releaseUrl = 'https://github.com/moaiy-com/moaiy/releases';
const [downloadMidAd] = adPlacementMap.download;
---

<BaseLayout {...seo}>
  <main class="page-shell">
    <div class="page-container">
      <PageHero
        title="Download Moaiy for macOS"
        subtitle="Get the official native macOS app from GitHub Releases and verify your download before installing."
      />

      <Panel tone="strong">
        <h2 class="font-heading text-2xl font-semibold text-text-primary md:text-3xl">Official macOS release</h2>
        <p class="mt-3 max-w-3xl text-sm leading-relaxed text-text-secondary">
          Moaiy is distributed free and open source through GitHub Releases. Download the latest macOS build, check the published SHA-256 checksum, and drag <strong>Moaiy.app</strong> into your <strong>Applications</strong> folder.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href={releaseUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-analytics-event="download_click"
            class="btn-primary"
          >
            Open GitHub Releases
          </a>
          <a href="/verification/" class="btn-secondary">
            Check Verification Guide
          </a>
        </div>
      </Panel>

      <Panel class="mt-12">
        <h2 class="font-heading text-2xl font-semibold text-text-primary md:text-3xl">Platform availability</h2>
        <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2">
          <div class="rounded-lg border border-line-subtle bg-bg-primary/45 p-4">
            <p class="text-xs font-semibold uppercase tracking-[0.08em] text-accent-primary">macOS (Native GUI App)</p>
            <p class="mt-1 text-sm text-text-secondary">Available now from official GitHub Releases.</p>
          </div>
          <div class="rounded-lg border border-line-subtle bg-bg-primary/45 p-4">
            <p class="text-xs font-semibold uppercase tracking-[0.08em] text-accent-primary">Windows / Linux</p>
            <p class="mt-1 text-sm text-text-secondary">Planned. Follow progress in Roadmap and Release Notes.</p>
          </div>
          <div class="rounded-lg border border-line-subtle bg-bg-primary/45 p-4">
            <p class="text-xs font-semibold uppercase tracking-[0.08em] text-accent-primary">iOS / Android</p>
            <p class="mt-1 text-sm text-text-secondary">Planned, not available yet.</p>
          </div>
          <div class="rounded-lg border border-line-subtle bg-bg-primary/45 p-4">
            <p class="text-xs font-semibold uppercase tracking-[0.08em] text-accent-primary">Automation / API</p>
            <p class="mt-1 text-sm text-text-secondary">Planned, not publicly available yet.</p>
          </div>
        </div>
      </Panel>

      <AdSlot pageKey="download" {...downloadMidAd} class="mt-12" />

      <Panel class="mt-12">
        <h2 class="font-heading text-2xl font-semibold text-text-primary md:text-3xl">Using Moaiy with smart cards</h2>
        <p class="mt-3 text-sm leading-relaxed text-text-secondary">
          If you store OpenPGP keys on a smart card or hardware token (such as a YubiKey), verify your card unlock flow and offline backup process before relying on it for critical files.
        </p>
        <a href="/smartcard-encryption-guide/" class="mt-4 inline-flex text-sm font-semibold text-accent-primary hover:underline">
          Open smart card encryption guide
        </a>
      </Panel>

      <Panel class="mt-12">
        <h2 class="font-heading text-2xl font-semibold text-text-primary md:text-3xl">Build from source in Xcode (optional)</h2>
        <p class="mt-3 text-sm leading-relaxed text-text-secondary">
          If you prefer to compile Moaiy yourself, clone the repository and build the native macOS target in Xcode:
        </p>
        <div class="code-block">
          <div>git clone https://github.com/moaiy-com/moaiy.git</div>
          <div>cd moaiy</div>
          <div>open Moaiy/Moaiy.xcodeproj</div>
        </div>
      </Panel>

      <section class="link-grid">
        <LinkCard href="/verification/" title="Verification" description="Checklist to verify downloads before install." />
        <LinkCard href="/release-notes/" title="Release Notes" description="Recent product and site milestones." />
        <LinkCard href="/roadmap/" title="Roadmap" description="What is available now and what comes next." />
      </section>
    </div>
  </main>
</BaseLayout>
