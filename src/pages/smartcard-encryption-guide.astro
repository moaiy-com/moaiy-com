---
import LinkCard from '../components/ui/LinkCard.astro';
import PageHero from '../components/ui/PageHero.astro';
import Panel from '../components/ui/Panel.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageSeo } from '../seo/page-config';

const seo = pageSeo.smartcardEncryptionGuide;
---

<BaseLayout {...seo}>
  <main class="page-shell">
    <div class="page-container">
      <PageHero
        title="Smart Card Encryption Guide"
        subtitle="Practical steps for pairing OpenPGP smart cards and hardware tokens with Moaiy on macOS."
      />

      <Panel tone="strong">
        <h2 class="font-heading text-2xl font-semibold text-text-primary md:text-3xl">When smart cards help</h2>
        <p class="mt-3 text-sm leading-relaxed text-text-secondary">
          OpenPGP smart cards and hardware tokens (such as YubiKey) keep your private keys isolated on dedicated hardware rather than on your Mac’s internal drive. They are ideal for users who encrypt sensitive files regularly and want stronger protection against key extraction.
        </p>
      </Panel>

      <section class="mt-12 grid grid-cols-1 gap-5 lg:grid-cols-3">
        <Panel as="article" class="p-6">
          <h3 class="font-heading text-xl text-text-primary">1. Keep keys organized</h3>
          <p class="mt-3 text-sm leading-relaxed text-text-secondary">
            Use clear labels for each card’s identity, key purpose, and expiration date. Keep a written inventory when managing primary and backup tokens.
          </p>
        </Panel>
        <Panel as="article" class="p-6">
          <h3 class="font-heading text-xl text-text-primary">2. Test daily unlock flow</h3>
          <p class="mt-3 text-sm leading-relaxed text-text-secondary">
            Plug in your token, open Moaiy on your Mac, and test encrypting and decrypting a sample file with your PIN before relying on the setup for urgent work.
          </p>
        </Panel>
        <Panel as="article" class="p-6">
          <h3 class="font-heading text-xl text-text-primary">3. Plan recovery first</h3>
          <p class="mt-3 text-sm leading-relaxed text-text-secondary">
            Store your revocation certificate and offline key backup in a secure, separate location—and test your recovery steps before you ever lose a hardware token.
          </p>
        </Panel>
      </section>

      <Panel class="mt-12">
        <h2 class="font-heading text-2xl font-semibold text-text-primary md:text-3xl">Operational checklist</h2>
        <ul class="list-compact">
          <li>Record each hardware token’s model, serial number, and assigned key fingerprint.</li>
          <li>Set a strong user PIN and Admin PIN, and store the Admin PIN / reset code offline.</li>
          <li>Test drag-and-drop encryption and decryption in Moaiy before daily production use.</li>
          <li>Keep offline backup keys physically separate from your everyday workstation and token.</li>
          <li>Update your backup and recovery notes whenever you rotate or renew keys.</li>
        </ul>
      </Panel>

      <section class="link-grid">
        <LinkCard href="/docs/" title="Docs" description="Visual macOS usage steps and FAQs." />
        <LinkCard href="/download/" analyticsEvent="download_click" title="Download" description="Official macOS release channel." />
        <LinkCard href="/security/" title="Security" description="Project security model and reporting policy." />
      </section>
    </div>
  </main>
</BaseLayout>
