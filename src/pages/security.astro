---
import LinkCard from '../components/ui/LinkCard.astro';
import PageHero from '../components/ui/PageHero.astro';
import Panel from '../components/ui/Panel.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageSeo } from '../seo/page-config';

const seo = pageSeo.security;
---

<BaseLayout {...seo}>
  <main class="page-shell">
    <div class="page-container">
      <PageHero
        title="How Moaiy keeps your files safe"
        subtitle="Start with a plain-language summary, then review technical details, verification steps, and vulnerability disclosure guidelines."
      />

      <Panel tone="strong">
        <h2 class="font-heading text-2xl font-semibold text-text-primary md:text-3xl">Quick summary (for most people)</h2>
        <ul class="list-compact">
          <li>Your files are encrypted and decrypted 100% locally on your Mac—never uploaded to a remote server.</li>
          <li>Moaiy uses standard, interoperable OpenPGP cryptography and is open source under the MIT License.</li>
          <li>Official downloads are published on GitHub Releases with SHA-256 checksums for pre-install verification.</li>
          <li>If you discover a security vulnerability, report it privately to <a href="mailto:security@moaiy.com" class="text-accent-primary hover:underline">security@moaiy.com</a>.</li>
        </ul>
      </Panel>

      <h2 class="mt-12 font-heading text-2xl font-semibold text-text-primary md:text-3xl">Technical pillars</h2>

      <section class="grid grid-cols-1 gap-5 md:grid-cols-3">
        <Panel as="article" tone="strong" class="p-6">
          <h2 class="font-heading text-xl font-semibold text-text-primary">Public codebase</h2>
          <p class="mt-3 text-sm leading-relaxed text-text-secondary">
            Full source code, commit history, and issue tracking remain publicly auditable in the official GitHub repository.
          </p>
        </Panel>
        <Panel as="article" tone="strong" class="p-6">
          <h2 class="font-heading text-xl font-semibold text-text-primary">Local-first processing</h2>
          <p class="mt-3 text-sm leading-relaxed text-text-secondary">
            Encryption, decryption, and key management run locally on your Mac with zero cloud accounts or remote API calls.
          </p>
        </Panel>
        <Panel as="article" tone="strong" class="p-6">
          <h2 class="font-heading text-xl font-semibold text-text-primary">Verification guidance</h2>
          <p class="mt-3 text-sm leading-relaxed text-text-secondary">
            Official documentation includes step-by-step SHA-256 checksum and signature validation before installation.
          </p>
        </Panel>
      </section>

      <section class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-2">
        <Panel as="article">
          <h2 class="font-heading text-2xl font-semibold text-text-primary">How to report a vulnerability</h2>
          <ul class="list-compact">
            <li>
              Send reports privately to
              <a href="mailto:security@moaiy.com" class="text-accent-primary hover:underline">security@moaiy.com</a>
              (also published in <a href="/.well-known/security.txt" class="text-accent-primary hover:underline">/.well-known/security.txt</a>).
            </li>
            <li>Include reproduction steps, affected macOS and app version, and an impact assessment.</li>
            <li>Please allow time for coordinated remediation before public disclosure.</li>
          </ul>
        </Panel>
        <Panel as="article">
          <h2 class="font-heading text-2xl font-semibold text-text-primary">Response targets</h2>
          <ul class="list-compact">
            <li>Acknowledgement target: within 3 business days.</li>
            <li>Technical triage target: within 7 business days when reproducible.</li>
            <li>Remediation release timeline prioritized by severity and user impact.</li>
          </ul>
        </Panel>
      </section>

      <Panel class="mt-12">
        <h2 class="font-heading text-2xl font-semibold text-text-primary md:text-3xl">Security assurance & documentation</h2>
        <div class="mt-6 overflow-x-auto">
          <table class="w-full min-w-[560px] text-left text-sm text-text-secondary">
            <thead>
              <tr class="border-b border-line-subtle text-text-primary">
                <th class="py-3 pr-4 font-heading">Area</th>
                <th class="px-4 py-3 font-heading">Status</th>
                <th class="px-4 py-3 font-heading">How to verify</th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-b border-line-strong">
                <td class="py-3 pr-4">Public source review</td>
                <td class="px-4 py-3 text-accent-primary">Available</td>
                <td class="px-4 py-3">Inspect repository, commit history, and Xcode project on GitHub.</td>
              </tr>
              <tr class="border-b border-line-strong">
                <td class="py-3 pr-4">Release checksum verification</td>
                <td class="px-4 py-3 text-accent-primary">Available</td>
                <td class="px-4 py-3"><a href="/verification/" class="text-accent-primary hover:underline">Follow SHA-256 verification guide</a></td>
              </tr>
              <tr>
                <td class="py-3 pr-4">Security architecture whitepaper</td>
                <td class="px-4 py-3 text-accent-primary">Published</td>
                <td class="px-4 py-3"><a href="/security-whitepaper/" class="text-accent-primary hover:underline">Read technical whitepaper</a></td>
              </tr>
            </tbody>
          </table>
        </div>
      </Panel>

      <section class="link-grid">
        <LinkCard href="/verification/" title="Verification Guide" description="Checksum and signature checks." />
        <LinkCard href="/security-whitepaper/" title="Security Whitepaper" description="Threat model and local architecture." />
        <LinkCard href="https://github.com/moaiy-com/moaiy/releases" target="_blank" title="Release Artifacts" description="Official build and checksum channel." />
      </section>
    </div>
  </main>
</BaseLayout>
