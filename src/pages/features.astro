---
import LinkCard from '../components/ui/LinkCard.astro';
import PageHero from '../components/ui/PageHero.astro';
import Panel from '../components/ui/Panel.astro';
import AdSlot from '../components/ads/AdSlot.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { adPlacementMap } from '../config/ad-placements';
import { pageSeo } from '../seo/page-config';

const seo = pageSeo.features;
const [featuresMidAd] = adPlacementMap.features;
---

<BaseLayout {...seo}>
  <main class="page-shell">
    <div class="page-container">
      <PageHero
        title="Features built for everyday Mac encryption"
        subtitle="Moaiy brings standard OpenPGP file protection into a clean, native macOS interface—so you can protect files without touching the command line."
      />

      <section class="grid grid-cols-1 gap-5 md:grid-cols-3">
        <Panel as="article" tone="strong" class="p-6">
          <h2 class="font-heading text-xl font-semibold text-text-primary">Drag-and-drop simplicity</h2>
          <p class="mt-3 text-sm leading-relaxed text-text-secondary">
            Drop any file or archive directly into Moaiy to encrypt or decrypt in seconds through a guided visual workflow.
          </p>
        </Panel>
        <Panel as="article" tone="strong" class="p-6">
          <h2 class="font-heading text-xl font-semibold text-text-primary">Recipient & password modes</h2>
          <p class="mt-3 text-sm leading-relaxed text-text-secondary">
            Encrypt files for specific contacts using OpenPGP public keys, or lock files with a shared passphrase when recipients do not use PGP yet.
          </p>
        </Panel>
        <Panel as="article" tone="strong" class="p-6">
          <h2 class="font-heading text-xl font-semibold text-text-primary">Visual keyring & local trust</h2>
          <p class="mt-3 text-sm leading-relaxed text-text-secondary">
            Create, import, and export keys in a clear visual keyring. All encryption happens locally on your Mac with public open-source code.
          </p>
        </Panel>
      </section>

      <AdSlot pageKey="features" {...featuresMidAd} class="mt-12" />

      <Panel class="mt-12">
        <h2 class="font-heading text-2xl font-semibold text-text-primary md:text-3xl">Visual workflow at a glance</h2>
        <ol class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2">
          <li class="rounded-lg border border-line-subtle bg-bg-primary/50 p-4">
            <p class="text-xs font-semibold uppercase tracking-[0.08em] text-accent-primary">Step 1 · Set up keys</p>
            <p class="mt-1 text-sm text-text-secondary">Create your own OpenPGP key pair in Moaiy’s visual Key Manager, or import a collaborator’s public key.</p>
          </li>
          <li class="rounded-lg border border-line-subtle bg-bg-primary/50 p-4">
            <p class="text-xs font-semibold uppercase tracking-[0.08em] text-accent-primary">Step 2 · Drag & drop files</p>
            <p class="mt-1 text-sm text-text-secondary">Drop documents, zip archives, or backups directly into the Moaiy window on your Mac.</p>
          </li>
          <li class="rounded-lg border border-line-subtle bg-bg-primary/50 p-4">
            <p class="text-xs font-semibold uppercase tracking-[0.08em] text-accent-primary">Step 3 · Choose protection mode</p>
            <p class="mt-1 text-sm text-text-secondary">Select recipient public keys or enter a password, then click Encrypt to lock the file locally.</p>
          </li>
          <li class="rounded-lg border border-line-subtle bg-bg-primary/50 p-4">
            <p class="text-xs font-semibold uppercase tracking-[0.08em] text-accent-primary">Step 4 · Share or decrypt easily</p>
            <p class="mt-1 text-sm text-text-secondary">Send the encrypted `.gpg` file over any channel, or drop encrypted files back into Moaiy to unlock them.</p>
          </li>
        </ol>
      </Panel>

      <Panel class="mt-12">
        <h2 class="font-heading text-2xl font-semibold text-text-primary md:text-3xl">Hardware-backed smart card support</h2>
        <p class="mt-3 text-sm leading-relaxed text-text-secondary">
          Many users combine Moaiy with OpenPGP smart cards or hardware tokens (such as YubiKey) so private keys never touch the Mac’s internal disk.
          This setup pairs well with a clear backup and recovery plan.
        </p>
        <a href="/smartcard-encryption-guide/" class="mt-4 inline-flex text-sm font-semibold text-accent-primary hover:underline">
          Read the smart card setup guide
        </a>
      </Panel>

      <section class="link-grid">
        <LinkCard href="/docs/" title="Read Docs" description="Step-by-step visual guides and FAQs." />
        <LinkCard href="/download/" analyticsEvent="download_click" title="Get Releases" description="Official macOS app and install path." />
        <LinkCard href="/security/" title="Security Model" description="Local privacy, verification, and disclosure policy." />
      </section>
    </div>
  </main>
</BaseLayout>
