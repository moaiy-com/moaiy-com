---
import LinkCard from '../components/ui/LinkCard.astro';
import PageHero from '../components/ui/PageHero.astro';
import Panel from '../components/ui/Panel.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageSeo } from '../seo/page-config';

const seo = pageSeo.encryptFilesOnMacos;
const releaseUrl = 'https://github.com/moaiy-com/moaiy/releases';
---

<BaseLayout {...seo}>
  <main class="page-shell">
    <div class="page-container-compact">
      <PageHero
        centered={false}
        title="Encrypt files on macOS with Moaiy"
        subtitle="A visual, drag-and-drop workflow for locking sensitive files, managing keys, and sharing safely—with zero terminal commands."
      />

      <section class="space-y-5">
        <Panel as="article" tone="strong" class="p-6 md:p-7">
          <h2 class="font-heading text-2xl font-semibold text-text-primary">1. Install the official macOS app</h2>
          <p class="mt-3 text-sm leading-relaxed text-text-secondary">
            Download the latest Moaiy release for macOS from official GitHub Releases and move <strong>Moaiy.app</strong> to your Applications folder.
          </p>
          <a
            href={releaseUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-analytics-event="download_click"
            class="btn-primary mt-4"
          >
            Open Releases
          </a>
        </Panel>

        <Panel as="article" class="p-6 md:p-7">
          <h2 class="font-heading text-2xl font-semibold text-text-primary">2. Set up your keys in Key Manager</h2>
          <p class="mt-3 text-sm leading-relaxed text-text-secondary">
            Open Moaiy and create your personal OpenPGP key pair in a few clicks, or import the public key of the colleague or client you want to share files with.
          </p>
        </Panel>

        <Panel as="article" class="p-6 md:p-7">
          <h2 class="font-heading text-2xl font-semibold text-text-primary">3. Drag, drop, and encrypt</h2>
          <p class="mt-3 text-sm leading-relaxed text-text-secondary">
            Drag your file (for example, <code>contracts.zip</code>) directly into the Moaiy window. Choose <strong>Recipient Mode</strong> to lock it for specific public keys, or <strong>Password Mode</strong> to protect it with a shared passphrase, then click <strong>Encrypt</strong>.
          </p>
        </Panel>

        <Panel as="article" class="p-6 md:p-7">
          <h2 class="font-heading text-2xl font-semibold text-text-primary">4. Share encrypted files anywhere</h2>
          <p class="mt-3 text-sm leading-relaxed text-text-secondary">
            Because encryption happens locally on your Mac before the file ever leaves your drive, you can safely send the resulting <code>.gpg</code> file over email, chat, or cloud storage.
          </p>
          <a href="/verification/" class="mt-4 inline-flex text-sm font-semibold text-accent-primary hover:underline">Read download verification guide</a>
        </Panel>
      </section>

      <section class="mt-12 grid grid-cols-1 gap-4 md:grid-cols-2">
        <LinkCard href="/docs/" title="Full Docs" description="Visual step-by-step guides and FAQs." />
        <LinkCard href="/gpg-tools-alternative/" title="Compare Alternatives" description="See how Moaiy compares with traditional GPG tools." />
      </section>
    </div>
  </main>
</BaseLayout>
